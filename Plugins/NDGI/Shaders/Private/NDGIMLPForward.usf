/*=============================================================================
	NDGIMLPForward.usf
	Per-sample MLP forward pass for kernel validation against the CPU reference.
	Writes outputs [NumSamples * NDGI_OUTPUT_DIM] followed by per-sample losses [NumSamples].
=============================================================================*/

#include "/Engine/Private/Common.ush"
#include "NDGIMLP.ush"

StructuredBuffer<float> MLPParameters;
StructuredBuffer<float> SampleInputs;
StructuredBuffer<float> SampleTargets;
RWStructuredBuffer<float> ForwardResults;
uint NumSamples;

[numthreads(64, 1, 1)]
void ForwardMainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	uint SampleIndex = DispatchThreadId.x;
	if (SampleIndex >= NumSamples)
	{
		return;
	}

	float SampleInput[NDGI_INPUT_DIM];
	[unroll]
	for (int k = 0; k < NDGI_INPUT_DIM; ++k)
	{
		SampleInput[k] = SampleInputs[SampleIndex * NDGI_INPUT_DIM + k];
	}

	NDGIMLPForwardCache Cache;
	NDGIMLPForward(0u, MLPParameters, SampleInput, Cache);

	float Loss = 0.0f;
	[unroll]
	for (int j = 0; j < NDGI_OUTPUT_DIM; ++j)
	{
		const float Predicted = Cache.Output[j];
		const float Target = SampleTargets[SampleIndex * NDGI_OUTPUT_DIM + j];
		ForwardResults[SampleIndex * NDGI_OUTPUT_DIM + j] = Predicted;
		const float Diff = Predicted - Target;
		Loss += NDGIOutputWeight((uint)j) * Diff * Diff;
	}
	ForwardResults[NumSamples * NDGI_OUTPUT_DIM + SampleIndex] = Loss;
}
