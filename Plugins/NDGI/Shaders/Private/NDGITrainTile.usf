/*=============================================================================
	NDGITrainTile.usf
	One training step for one batch of samples for every tile in the dispatch.

	Thread mapping: one threadgroup per tile, one thread per sample (<= 64).
	Per thread: sample all four feature maps (with noise), MLP forward/backward,
	then scatter the input gradient into fixed-point gradient atomics. The MLP
	parameter gradients are reduced in groupshared memory and written once per
	group into the shared gradient buffer.
=============================================================================*/

#include "/Engine/Private/Common.ush"
#include "NDGIMLP.ush"
#include "NDGITile.ush"

StructuredBuffer<float> TileParameters;
StructuredBuffer<float> SampleCoords;
StructuredBuffer<float> SampleTargets;
StructuredBuffer<float> SampleNoise;
RWStructuredBuffer<int> GradientInt;

// Members of the SHADER_PARAMETER_STRUCT_INCLUDE'd NDGITileParameters are bound
// by their bare leaf names (see SHADER_PARAMETER_STRUCT_INCLUDE documentation).
uint UVSize;
uint UVTSize;
uint UTSize;
uint VTSize;
uint TimeSlices;
uint UVBlocksX;
uint UVTBlocksX;
uint MLPOffset;
uint UVE1Offset;
uint UVE2Offset;
uint UVWOffset;
uint UVTE1Offset;
uint UVTE2Offset;
uint UVTWOffset;
uint UTOffset;
uint VTOffset;
uint TotalParams;

uint NumSteps;
uint BatchSize;
uint StepIndex;

groupshared int SharedMLPGrad[NDGI_NUM_PARAMETERS];

[numthreads(64, 1, 1)]
void TrainTileCS(uint3 GroupId : SV_GroupID, uint3 ThreadId : SV_GroupThreadID)
{
	NDGITileParameters TileParams;
	TileParams.UVSize = UVSize;
	TileParams.UVTSize = UVTSize;
	TileParams.UTSize = UTSize;
	TileParams.VTSize = VTSize;
	TileParams.TimeSlices = TimeSlices;
	TileParams.UVBlocksX = UVBlocksX;
	TileParams.UVTBlocksX = UVTBlocksX;
	TileParams.MLPOffset = MLPOffset;
	TileParams.UVE1Offset = UVE1Offset;
	TileParams.UVE2Offset = UVE2Offset;
	TileParams.UVWOffset = UVWOffset;
	TileParams.UVTE1Offset = UVTE1Offset;
	TileParams.UVTE2Offset = UVTE2Offset;
	TileParams.UVTWOffset = UVTWOffset;
	TileParams.UTOffset = UTOffset;
	TileParams.VTOffset = VTOffset;
	TileParams.TotalParams = TotalParams;

	const uint TileIndex = GroupId.x;
	const uint SampleIndex = ThreadId.x;
	const uint Base = TileIndex * TileParams.TotalParams;

	[loop]
	for (uint Init = ThreadId.x; Init < NDGI_NUM_PARAMETERS; Init += 64)
	{
		SharedMLPGrad[Init] = 0;
	}
	GroupMemoryBarrierWithGroupSync();

	if (SampleIndex < BatchSize)
	{
		const uint SampleGlobal = (TileIndex * NumSteps + StepIndex) * BatchSize + SampleIndex;
		const float3 Coord = float3(
			SampleCoords[SampleGlobal * 3 + 0],
			SampleCoords[SampleGlobal * 3 + 1],
			SampleCoords[SampleGlobal * 3 + 2]);

		// Sample the four feature maps.
		float Vuv[4], Vut[2], Vvt[2], Vuvt[4];
		NDGITileTaps Taps;
		NDGISampleTile(Base, TileParams, TileParameters, Coord.x, Coord.y, Coord.z, Vuv, Vut, Vvt, Vuvt, Taps);

		// Concatenate with noise and the time encoding (matches the CPU reference).
		float Input[NDGI_INPUT_DIM];
		[unroll]
		for (uint c = 0; c < 4; ++c)
		{
			Input[c] = Vuv[c] + SampleNoise[SampleGlobal * 12 + c];
			Input[8 + c] = Vuvt[c] + SampleNoise[SampleGlobal * 12 + 8 + c];
		}
		Input[4] = Vut[0] + SampleNoise[SampleGlobal * 12 + 4];
		Input[5] = Vut[1] + SampleNoise[SampleGlobal * 12 + 5];
		Input[6] = Vvt[0] + SampleNoise[SampleGlobal * 12 + 6];
		Input[7] = Vvt[1] + SampleNoise[SampleGlobal * 12 + 7];
		const float Time = Coord.z;
		Input[12] = sin(2.0 * PI * Time);
		Input[13] = cos(2.0 * PI * Time);
		Input[14] = sin(4.0 * PI * Time);
		Input[15] = cos(4.0 * PI * Time);

		// MLP forward / backward.
		NDGIMLPForwardCache Cache;
		NDGIMLPForward(Base + TileParams.MLPOffset, TileParameters, Input, Cache);

		float OutputGradients[NDGI_OUTPUT_DIM];
		[unroll]
		for (uint j = 0; j < NDGI_OUTPUT_DIM; ++j)
		{
			OutputGradients[j] = 2.0f * NDGIOutputWeight(j)
				* (Cache.Output[j] - SampleTargets[SampleGlobal * NDGI_OUTPUT_DIM + j]);
		}

		float ParameterGradients[NDGI_NUM_PARAMETERS];
		[loop]
		for (uint p = 0; p < NDGI_NUM_PARAMETERS; ++p)
		{
			ParameterGradients[p] = 0.0f;
		}
		float InputGradients[NDGI_INPUT_DIM];
		[unroll]
		for (uint g = 0; g < NDGI_INPUT_DIM; ++g)
		{
			InputGradients[g] = 0.0f;
		}

		NDGIMLPBackward(Base + TileParams.MLPOffset, TileParameters, Input, Cache, OutputGradients, ParameterGradients, InputGradients);

		// Reduce MLP gradients within the group (fixed-point atomics in groupshared memory).
		[loop]
		for (uint p2 = 0; p2 < NDGI_NUM_PARAMETERS; ++p2)
		{
			InterlockedAdd(SharedMLPGrad[p2], (int)round(ParameterGradients[p2] * NDGI_GRAD_SCALE));
		}

		// Scatter the input gradient into the feature-map parameter atomics.
		float DVuv[4] = { InputGradients[0], InputGradients[1], InputGradients[2], InputGradients[3] };
		float DVut[2] = { InputGradients[4], InputGradients[5] };
		float DVvt[2] = { InputGradients[6], InputGradients[7] };
		float DVuvt[4] = { InputGradients[8], InputGradients[9], InputGradients[10], InputGradients[11] };
		NDMScatterUV(Base, TileParams, TileParameters, GradientInt, Taps, DVuv);
		NDMScatterUT(Base, TileParams, GradientInt, Taps, DVut);
		NDMScatterVT(Base, TileParams, GradientInt, Taps, DVvt);
		NDMScatterUVT(Base, TileParams, TileParameters, GradientInt, Taps, DVuvt);
	}

	GroupMemoryBarrierWithGroupSync();

	[loop]
	for (uint p3 = ThreadId.x; p3 < NDGI_NUM_PARAMETERS; p3 += 64)
	{
		InterlockedAdd(GradientInt[Base + TileParams.MLPOffset + p3], SharedMLPGrad[p3]);
	}
}
