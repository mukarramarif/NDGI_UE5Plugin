/*=============================================================================
	NDGIRuntimeDecode.usf
	Forward-only NDGI decode: samples the finalized feature representation and
	runs the MLP for every requested (u, v, t). Same sampling/MLP code as training,
	so runtime and training stay numerically consistent (paper Section 3.5).
=============================================================================*/

#include "/Engine/Private/Common.ush"
#include "NDGIMLP.ush"
#include "NDGITile.ush"

StructuredBuffer<float> TileParameters;
StructuredBuffer<float> SampleCoords;
RWStructuredBuffer<float> DecodedOutput;

// NDGITileParameters include members (bound by bare leaf names).
uint UVSize;
uint UVTSize;
uint UTSize;
uint VTSize;
uint TimeSlices;
uint UVBlocksX;
uint UVTBlocksX;
uint MLPOffset;
uint UVE1Offset;
uint UVE2Offset;
uint UVWOffset;
uint UVTE1Offset;
uint UVTE2Offset;
uint UVTWOffset;
uint UTOffset;
uint VTOffset;
uint TotalParams;

uint NumSamples;
uint TileIndex;

[numthreads(64, 1, 1)]
void DecodeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint SampleIndex = DispatchThreadId.x;
	if (SampleIndex >= NumSamples)
	{
		return;
	}

	NDGITileParameters TileParams;
	TileParams.UVSize = UVSize;
	TileParams.UVTSize = UVTSize;
	TileParams.UTSize = UTSize;
	TileParams.VTSize = VTSize;
	TileParams.TimeSlices = TimeSlices;
	TileParams.UVBlocksX = UVBlocksX;
	TileParams.UVTBlocksX = UVTBlocksX;
	TileParams.MLPOffset = MLPOffset;
	TileParams.UVE1Offset = UVE1Offset;
	TileParams.UVE2Offset = UVE2Offset;
	TileParams.UVWOffset = UVWOffset;
	TileParams.UVTE1Offset = UVTE1Offset;
	TileParams.UVTE2Offset = UVTE2Offset;
	TileParams.UVTWOffset = UVTWOffset;
	TileParams.UTOffset = UTOffset;
	TileParams.VTOffset = VTOffset;
	TileParams.TotalParams = TotalParams;

	const uint Base = TileIndex * TileParams.TotalParams;
	const float3 Coord = float3(
		SampleCoords[SampleIndex * 3 + 0],
		SampleCoords[SampleIndex * 3 + 1],
		SampleCoords[SampleIndex * 3 + 2]);

	float Vuv[4], Vut[2], Vvt[2], Vuvt[4];
	NDGITileTaps Taps;
	NDGISampleTile(Base, TileParams, TileParameters, Coord.x, Coord.y, Coord.z, Vuv, Vut, Vvt, Vuvt, Taps);

	float Input[NDGI_INPUT_DIM];
	[unroll]
	for (uint c = 0; c < 4; ++c)
	{
		Input[c] = Vuv[c];
		Input[8 + c] = Vuvt[c];
	}
	Input[4] = Vut[0];
	Input[5] = Vut[1];
	Input[6] = Vvt[0];
	Input[7] = Vvt[1];
	Input[12] = sin(2.0 * PI * Coord.z);
	Input[13] = cos(2.0 * PI * Coord.z);
	Input[14] = sin(4.0 * PI * Coord.z);
	Input[15] = cos(4.0 * PI * Coord.z);

	NDGIMLPForwardCache Cache;
	NDGIMLPForward(Base + TileParams.MLPOffset, TileParameters, Input, Cache);

	[unroll]
	for (uint j = 0; j < NDGI_OUTPUT_DIM; ++j)
	{
		DecodedOutput[SampleIndex * NDGI_OUTPUT_DIM + j] = Cache.Output[j];
	}
}
